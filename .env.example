# ---------------------------------------------------------------- Milvus ----
MILVUS_URI=http://localhost:19530
# Zilliz Cloud / authenticated Milvus: "user:password" or an API key.
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_service

# HNSW | IVF_FLAT | DISKANN | AUTOINDEX
# HNSW below ~10M vectors. DISKANN past that, or IVF_FLAT if memory-bound.
MILVUS_DENSE_INDEX_TYPE=HNSW
MILVUS_HNSW_M=24
MILVUS_HNSW_EF_CONSTRUCTION=256
MILVUS_SPARSE_INDEX_ALGO=DAAT_MAXSCORE
MILVUS_CONSISTENCY_LEVEL=Bounded

# ------------------------------------------------------------- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
# Leave blank for the model's native dimensionality. Set explicitly to use
# Matryoshka truncation (e.g. 3-large at 1024 beats 3-small at 1536, for a
# third of the storage).
EMBEDDING_DIM=
EMBEDDING_API_KEY=sk-replace-me
EMBEDDING_BATCH_SIZE=128
EMBEDDING_CACHE_ENABLED=true
# Optional per-tenant key overrides. The MODEL stays service-wide - mixing
# embedding models inside one collection destroys retrieval quality.
# EMBEDDING_TENANT_KEYS={"org_abc":"sk-..."}

# --------------------------------------------------------------- Chunking ---
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=24
CHUNK_PREPEND_TITLE=true

# -------------------------------------------------------------- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_FETCH_MULTIPLIER=6
RETRIEVAL_FUSION=rrf
RETRIEVAL_RRF_K=60
RETRIEVAL_HNSW_EF=128
RETRIEVAL_SPARSE_DROP_RATIO=0.2
RETRIEVAL_RECENT_HISTORY_TURNS=4
RETRIEVAL_MMR_ENABLED=true
RETRIEVAL_MMR_LAMBDA=0.7

# none | cohere | local
RETRIEVAL_RERANK_PROVIDER=none
RETRIEVAL_RERANK_MODEL=rerank-v3.5
RETRIEVAL_RERANK_API_KEY=

# --------------------------------------------------------------- Messaging --
# redis | gcp
BUS_BACKEND=redis
BUS_REDIS_URL=redis://localhost:6379/0
BUS_STREAM=rag.events
BUS_GROUP=rag-workers
BUS_DLQ_STREAM=rag.events.dlq
BUS_REPLY_STREAM_DEFAULT=rag.results
BUS_BATCH_SIZE=16
BUS_MAX_DELIVERIES=5
BUS_IDEMPOTENCY_TTL_SECONDS=86400

# BUS_BACKEND=gcp
# BUS_GCP_PROJECT=
# BUS_GCP_SUBSCRIPTION=
# BUS_GCP_REPLY_TOPIC=

# ---------------------------------------------------------------- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------ Chatterloop bot -----
# Acting as a user on the platform: subscribes to the bot entity's realtime
# channel and replies only when mentioned.
CHATTERLOOP_ENABLED=false
CHATTERLOOP_BOT_ENTITY_ID=
CHATTERLOOP_BOT_HANDLE=assistant
CHATTERLOOP_BOT_ALIASES=


# Addressed-only: the bot answers when named, and when somebody replies
# directly to something it said. Setting this false - replying to UNADDRESSED
# messages - is not implemented and raises at startup.
CHATTERLOOP_RESPOND_TO_MENTIONS_ONLY=true

# Whether a direct reply to one of the bot's own messages or comments counts as
# addressing it, with no @handle needed. False makes the bot mention-only
# exactly as it was before, and a message that does not name it costs no read.
CHATTERLOOP_ANSWER_REPLIES=true
# How many recent replies the probe looks at per conversation. Bounds the work
# per frame, not the conversation.
CHATTERLOOP_REPLY_PROBE_WINDOW=25

# Other bots. Two bots in one realm that both answer when addressed will
# otherwise talk to each other until someone notices the bill.
CHATTERLOOP_IGNORE_ENTITY_IDS=
CHATTERLOOP_COOLDOWN_SECONDS=5
CHATTERLOOP_MAX_REPLIES_PER_HOUR=30
CHATTERLOOP_HISTORY_WINDOW=40
CHATTERLOOP_TOP_K=8

# stub | openai. The stub reports what was retrieved instead of composing
# prose, which keeps retrieval quality debuggable separately from generation.
CHATTERLOOP_REPLY_GENERATOR=stub
CHATTERLOOP_REPLY_MODEL=gpt-4o-mini
CHATTERLOOP_REPLY_API_KEY=

# ------------------------------------------------------- Developer API -------
# This service reaches chatterloop ONLY through developer_service: history,
# mentions, replies and the realtime stream all come from one origin with one
# credential. There are no database or Redis credentials here any more, and no
# database drivers in the dependency set - the pipeline cannot touch the
# platform's stores even by mistake.
PLATFORM_ENABLED=false

# Issued by hand for now - see services/developer_service/README.md for the
# exact SQL. The token is shown once and is not recoverable.
#
# It needs five scopes, AND matching grant rows on its entity, because
# authorization is the intersection of the two:
#   messages.read  notifications.read  messages.send  comments.create
#   events.subscribe
#
# comments.create is the one added last. Without it the bot still reads and
# answers in MESSAGES, and every comment it is addressed in is generated and
# then refused at the send - which reads in the logs as a working bot that
# never speaks on posts.
PLATFORM_TOKEN=

# Origin only - the client appends /v1/... itself.
PLATFORM_API_BASE_URL=https://developer.chatterloop.app

PLATFORM_TIMEOUT_SECONDS=15
# Transient failures only. A 401/403 is never retried.
PLATFORM_MAX_ATTEMPTS=3
